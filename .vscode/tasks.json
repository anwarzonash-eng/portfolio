{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "git_pull_task",
			"type": "shell",
			"command": "git",
			"args": [
				"pull",
				"--no-rebase",
				"--no-edit"
			],
			"isBackground": false,
			"group": "none"
		},
		{
			"label": "git_commit_merge",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"--no-edit"
			],
			"isBackground": false,
			"group": "none"
		},
		{
			"label": "git_push_task",
			"type": "shell",
			"command": "git",
			"args": [
				"push"
			],
			"isBackground": false,
			"group": "none"
		}
	]
}